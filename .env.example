# 환경변수. 실제 값은 .env 에 넣으세요 (git 미추적).
# Prisma CLI는 .env.local을 읽지 않으므로 .env 하나로 통일합니다.

# OpenAI 키 하나로 STT/LLM/TTS 모두 처리
#   STT: gpt-4o-mini-transcribe / LLM: gpt-4o / TTS: gpt-4o-mini-tts
OPENAI_API_KEY=sk-...

# Neon Postgres. Vercel 마켓플레이스 연동 시 두 값이 자동 주입됩니다.
#   DATABASE_URL          — pooled (앱 런타임)
#   DATABASE_URL_UNPOOLED — 직결 (prisma migrate)
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require
