# 환경변수. 실제 값은 .env 에 넣으세요 (git 미추적).
# Prisma CLI는 .env.local을 읽지 않으므로 .env 하나로 통일합니다.

# OpenAI — STT/LLM, 그리고 코파일럿·사무장의 TTS
#   STT: gpt-4o-mini-transcribe / LLM: gpt-4o / 통화: gpt-realtime-2.1 / TTS: gpt-4o-mini-tts
OPENAI_API_KEY=sk-...

# Typecast — 훈련 통화(F1) 사기범 목소리. 한국어가 gpt-realtime보다 자연스럽다.
#   근거와 배역별 목소리 선정: docs/planning/tts-provider-spike.md
#   NEXT_PUBLIC_VOICE_PIPELINE=typecast 일 때만 쓰인다. 기본값은 realtime.
TYPECAST_API_KEY=

# 통화 목소리를 어디서 만들지: realtime | typecast (기본 realtime)
# 데모 중에는 /call?pipeline=realtime 쿼리가 이 값을 덮어쓴다.
NEXT_PUBLIC_VOICE_PIPELINE=realtime

# Neon Postgres. Vercel 마켓플레이스 연동 시 두 값이 자동 주입됩니다.
#   DATABASE_URL          — pooled (앱 런타임)
#   DATABASE_URL_UNPOOLED — 직결 (prisma migrate)
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require
