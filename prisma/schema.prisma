// 백신콜 데이터 모델.
// 실명·계좌번호 등 민감정보는 저장하지 않는다 (PRD §5). 부모의 name은 호칭이다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Neon pooled
  directUrl = env("DATABASE_URL_UNPOOLED") // migrate 전용 직결
}

// 자녀(보호자) 계정. 유일하게 가입·로그인하는 주체.
model Child {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String // "salt:hash" (scrypt, hex)
  createdAt     DateTime       @default(now())
  parents       Parent[]
  invites       Invite[]
  notifications Notification[]
}

// 부모(피보호자). 가입하지 않고 초대 링크로만 생성된다.
model Parent {
  id        String   @id @default(cuid())
  childId   String
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  name      String // 호칭 ("어머니" 등)
  ageGroup  String // lib/parent.ts의 AGE_GROUPS
  createdAt DateTime @default(now())
  reports   Report[]

  @@index([childId])
}

// 부모 초대 토큰. 1회용이며 만료된다. 재발급은 새 행을 만든다.
model Invite {
  token     String    @id
  childId   String
  child     Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([childId])
}

// 자녀·부모 공용 세션. 역할에 따라 childId 또는 parentId 중 하나가 채워진다.
model Session {
  token     String   @id
  role      String // "child" | "parent"
  childId   String?
  parentId  String?
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// 훈련 리포트. messages는 리포트 화면의 대화 타임라인 렌더에 필요하다.
model Report {
  id         String   @id @default(cuid())
  parentId   String
  parent     Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  scenarioId String
  report     Json // lib/report.ts의 TrainingReport
  messages   Json
  createdAt  DateTime @default(now())

  @@index([parentId, createdAt(sort: Desc)])
}

// 자녀 인앱 알림함. 웹 푸시는 범위 외.
model Notification {
  id        String    @id @default(cuid())
  childId   String
  child     Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  reportId  String?
  type      String // "report" | "risk"
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([childId, createdAt(sort: Desc)])
}
